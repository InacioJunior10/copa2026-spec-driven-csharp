@* Cabeçalho de dia, reaproveitando .day-label de site.css (mesmo padrão de ProximosJogos.razor). *@
<div class="day-label">
    <h3>@FormatarDia(Data)</h3>
    <span class="badge badge-done">@QuantidadeJogos jogo@(QuantidadeJogos > 1 ? "s" : "")</span>
</div>

@code {
    [Parameter, EditorRequired]
    public DateOnly Data { get; set; }

    [Parameter, EditorRequired]
    public int QuantidadeJogos { get; set; }

    // Mesmo formato de fmtDataLong() do protótipo: "Quinta-feira, 11 de Junho de 2026".
    private static readonly string[] DiasSemana =
        ["Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira", "Sábado"];

    private static readonly string[] Meses =
        ["", "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];

    private static string FormatarDia(DateOnly data)
    {
        var diaSemana = DiasSemana[(int)data.DayOfWeek];
        return $"{diaSemana}, {data.Day} de {Meses[data.Month]} de {data.Year}";
    }
}
