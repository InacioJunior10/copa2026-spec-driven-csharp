@using PortalCopa26.Services
@inject ILandingPageService LandingPageService

@* Jogos ainda sem placar oficial, agrupados pelos 2 dias mais próximos (D3). Markup/classes do protótipo. *@
<section class="section">
    <div class="section-header">
        <h2 class="section-title">Próximos Jogos</h2>
        <a href="/jogos" class="btn btn-outline btn-sm">Ver todos</a>
    </div>

    @if (_dias is null)
    {
        <p class="text-soft">Carregando...</p>
    }
    else if (_dias.Count == 0)
    {
        <p class="text-soft">Não há jogos futuros no momento.</p>
    }
    else
    {
        @foreach (var dia in _dias)
        {
            <div class="day-group">
                <div class="day-label">
                    <h3>@FormatarDia(dia.Data)</h3>
                    <span class="badge badge-next">@dia.Jogos.Count jogo@(dia.Jogos.Count > 1 ? "s" : "")</span>
                </div>
                <div class="game-list">
                    @foreach (var jogo in dia.Jogos)
                    {
                        <div class="game-card">
                            <div class="team-side">
                                @if (jogo.MandanteCodigo is not null)
                                {
                                    <img src="@FlagUrl(jogo.MandanteCodigo)" alt="@jogo.MandanteNome" class="flag-sm" />
                                    <div>
                                        <div class="team-name">@jogo.MandanteNome</div>
                                        <div class="team-code">@jogo.MandanteCodigo</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="team-name text-soft">@jogo.VagaMandante</div>
                                }
                            </div>
                            <div class="game-center">
                                <div class="badge badge-next">Próximo</div>
                                <div class="game-score">— : —</div>
                                <div class="game-time">
                                    @jogo.DataHora.ToString("HH:mm")
                                    @if (jogo.GrupoLetra is not null)
                                    {
                                        <span class="badge badge-group" style="margin-left:4px">Grp @jogo.GrupoLetra</span>
                                    }
                                </div>
                                <div class="game-meta">@jogo.Estadio · @jogo.Cidade</div>
                            </div>
                            <div class="team-side away">
                                @if (jogo.VisitanteCodigo is not null)
                                {
                                    <img src="@FlagUrl(jogo.VisitanteCodigo)" alt="@jogo.VisitanteNome" class="flag-sm" />
                                    <div>
                                        <div class="team-name">@jogo.VisitanteNome</div>
                                        <div class="team-code">@jogo.VisitanteCodigo</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="team-name text-soft">@jogo.VagaVisitante</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</section>

@code {
    private List<ProximosJogosDia>? _dias;

    protected override async Task OnInitializedAsync()
    {
        _dias = await LandingPageService.GetProximosJogosAsync();
    }

    private static string FlagUrl(string codigo) => $"https://api.fifa.com/api/v3/picture/flags-sq-4/{codigo}";

    // Mesmo formato de fmtDataLong() do protótipo: "Quinta-feira, 11 de Junho de 2026".
    private static readonly string[] DiasSemana =
        ["Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira", "Sábado"];

    private static readonly string[] Meses =
        ["", "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];

    private static string FormatarDia(DateOnly data)
    {
        var diaSemana = DiasSemana[(int)data.DayOfWeek];
        return $"{diaSemana}, {data.Day} de {Meses[data.Month]} de {data.Year}";
    }
}
